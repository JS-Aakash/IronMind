# ==============================================================================
# IronMind - Sovereign On-Premise AI Workbench Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Backend API Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME="IronMind Sovereign AI Workbench"
VERSION="0.1.0"
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000"

# Storage Directories (Absolute or relative to monorepo root)
STORAGE_UPLOADS_DIR=./storage/uploads
STORAGE_KNOWLEDGE_DIR=./storage/knowledge
STORAGE_ARTIFACTS_DIR=./storage/artifacts
STORAGE_TEMP_DIR=./storage/temp

# Model Gateway & Local Inference Settings
LOCAL_INFERENCE_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_REASONING_MODEL=qwen2.5:7b
DEFAULT_VISION_MODEL=qwen2.5-vl:7b
DEFAULT_CODER_MODEL=qwen2.5-coder:7b
DEFAULT_EMBEDDING_MODEL=bge-m3

# Sovereignty & Air-gap Enforcement
STRICT_AIRGAP_ENFORCEMENT=true
ALLOW_EXTERNAL_EGRESS=false

# Sandbox Execution Mode (docker | process)
SANDBOX_EXECUTION_MODE=process
SANDBOX_TIMEOUT_SECONDS=30
