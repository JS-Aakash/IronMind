# ==========================================
# Storage Management & Demo Preservation
# ==========================================
# Ignore ephemeral sandbox executions and temp files
storage/temp/*
!storage/temp/.gitkeep
storage/sandbox/*
!storage/sandbox/.gitkeep

# Exclude user uploads during ad-hoc runs, preserve standard demo assets
storage/uploads/*
!storage/uploads/.gitkeep
!storage/uploads/MRPL_Crude_Distillation_P101_PID.png
!storage/uploads/MRPL_P101_Inspection_Data.xlsx
!storage/uploads/MRPL_P101_Inspection_Scan.txt
!storage/uploads/MRPL_Approval_Note_P_101_Sample.docx
!storage/uploads/MRPL_Executive_Review_Sample.pptx

# Track standard knowledge base documents and vector registry
storage/knowledge/*
!storage/knowledge/.gitkeep
!storage/knowledge/*.pdf
!storage/knowledge/*.txt
!storage/knowledge/documents_registry.json
!storage/knowledge/vector_index.json

# Track standard deliverable registry and sample deliverables
storage/artifacts/*
!storage/artifacts/.gitkeep
!storage/artifacts/registry.json
!storage/artifacts/MRPL_Approval_Note_P_101_Sample.docx
!storage/artifacts/MRPL_P101_Inspection_Data_Analysis.xlsx
!storage/artifacts/iso13709_pump_hydraulics.py
!storage/artifacts/MRPL_Executive_Review_Sample.pptx

# Track flagship seed run, ignore ephemeral ad-hoc task runs
storage/tasks/*
!storage/tasks/.gitkeep
!storage/tasks/TASK_FLAGSHIP_001.json

# Track genesis audit ledger, ignore ephemeral task audit files
storage/audit/tasks/*
!storage/audit/tasks/.gitkeep
storage/audit/*.jsonl
!storage/audit/audit_ledger.jsonl
