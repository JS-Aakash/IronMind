# Ignore Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.venv
venv/
ENV/

# Ignore Node artifacts
node_modules/
.next/
out/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore environment variables
.env

# Storage contents (keep dirs via .gitkeep)
storage/uploads/*
!storage/uploads/.gitkeep
storage/knowledge/*
!storage/knowledge/.gitkeep
storage/artifacts/*
!storage/artifacts/.gitkeep
storage/temp/*
!storage/temp/.gitkeep

# OS and IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
